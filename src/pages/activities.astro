---
import { Picture } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageSection from '../components/PageSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { accent } from '../lib/accent';
import hero from '../assets/images/bumthang-trek.webp';
import cultural from '../assets/images/cultural.webp';
import biking from '../assets/images/bikeing1.webp';
import birds from '../assets/images/birdwatching2.webp';
import food from '../assets/images/bumtap-cuisine.webp';
import tgArtist from '../assets/images/thangka/artist-phuntsho.webp';
import tgWall from '../assets/images/thangka/thangka-wall.webp';
import tgMandala from '../assets/images/thangka/mandala-study.webp';
import tgTable from '../assets/images/thangka/painting-table.webp';
import tgBooth from '../assets/images/thangka/exhibition-booth.webp';
import tgHall from '../assets/images/thangka/exhibition-hall.webp';
import tgGallery from '../assets/images/thangka/gallery-hall.webp';
import tgViewing from '../assets/images/thangka/viewing-thangka.webp';
import tgWith from '../assets/images/thangka/with-artist.webp';
import buddha from '../assets/images/buddha-point.webp';

const activities = [
  { title: 'Culture & heritage', tag: 'Dzongs · temples · museums', img: cultural, text: 'Walk the great dzongs, visit the National Museum and Rinpung Dzong, stroll local markets and meet the craftspeople who keep Bhutan’s traditions alive.' },
  { title: 'Hiking & trekking', tag: 'Tiger’s Nest · Bumthang trails', img: hero, text: 'From the day hike to Paro Taktsang to quieter trails in the central valleys. Finish with a traditional hot stone bath to ease tired legs.' },
  { title: 'Cycling', tag: 'Mountain & valley rides', img: biking, text: 'Ride quiet roads and village paths with a support vehicle and a local guide. Routes are matched to your fitness and the season.' },
  { title: 'Bird watching', tag: 'Phobjikha · Bumthang', img: birds, text: 'Bhutan’s forests and wetlands are among the richest birding regions in the Himalaya, including the black-necked cranes of Phobjikha each winter.' },
  { title: 'Culinary experiences', tag: 'Farm-to-table', img: food, text: 'Taste ema datshi and local specialties, learn to cook with a host family and share meals made with ingredients from the village.' },
  { title: 'Pilgrimage', tag: 'Sacred sites', img: buddha, text: 'Journeys for Buddhist pilgrims to monasteries, stupas and holy sites, with guides who understand both the ritual and the history.' },
];
const thangkaGallery = [
  { img: tgWall, alt: 'A wall of thangka paintings in a red gallery', cap: 'A wall of thangka paintings' },
  { img: tgMandala, alt: 'Guests studying a mandala thangka with the artist', cap: 'Studying a mandala thangka with the artist' },
  { img: tgTable, alt: 'The artist painting with a guest at a long table', cap: 'Painting together at the table' },
  { img: tgWith, alt: 'A guest holding a painted mask beside the artist', cap: 'A guest with the artist and a painted mask' },
  { img: tgBooth, alt: 'The Quality Thangka Painting exhibition booth', cap: 'Quality Thangka Painting, exhibition booth' },
  { img: tgHall, alt: 'Visitors in an exhibition hall with red walls', cap: 'Exhibition held in China' },
  { img: tgGallery, alt: 'A gallery hall hung with thangka paintings', cap: 'The gallery hall' },
  { img: tgViewing, alt: 'Visitors looking at a large green Tara thangka', cap: 'Visitors admiring a large thangka' },
];
---
<PageLayout bodyClass="ap" title="Activities" description="Hiking, cycling, bird watching, culture, thangka painting workshops and more. Tailor-made activities across Bhutan.">
  <PageHero eyebrow="Activities" title="Walk it. Ride it. Taste it." intro="Beyond the classic tour, Bhutan rewards the curious. Choose the experiences that fit you and we’ll build the journey around them." image={hero} alt="Trekking in Bumthang" />

  <PageSection tone="ink" labelledby="act-title">
    <div class="pg-head">
      <p class="label" style="opacity:.7">Things to do</p>
      <h2 id="act-title" class="h3 reveal" set:html={accent('*Special-interest* journeys, planned end to end by our team in ~Thimphu~.')}></h2>
    </div>
    <div class="pg-cards">
      {activities.map((a, i) => (
        <article class="pg-card reveal" style={`--d:${(i % 3) * 100}ms`}>
          <Picture fallbackFormat="webp" src={a.img} alt={a.title} widths={[400, 800]} sizes="(min-width:900px) 30vw, 90vw" formats={['avif', 'webp']} loading="lazy" />
          <div class="body">
            <p class="pg-tag">{a.tag}</p>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        </article>
      ))}
    </div>
  </PageSection>

  <PageSection tone="paper" id="thangka" labelledby="thangka-title">
    <div class="pg-split">
      <Picture fallbackFormat="webp" src={tgArtist} alt="Artist Phuntsho Wangdi painting a mask" widths={[480, 900]} sizes="(min-width:900px) 40vw, 100vw" formats={['avif', 'webp']} class="tg-portrait reveal" />
      <div>
        <div class="pg-head">
          <p class="label" style="opacity:.7">Traditional arts & crafts · Paro</p>
          <h2 id="thangka-title" class="h3 reveal" set:html={accent('*Thangka* painting ~workshop~')}></h2>
          <p class="pg-text reveal">Learn about Bhutanese sacred art from Phuntsho Wangdi, an artist based in Paro who owns a Quality Thangka Painting store of Traditional Arts &amp; Crafts. He also takes workshop classes for visitors who are keen to know more about Bhutanese arts, with limited seats so every participant gets proper attention.</p>
        </div>
        <table class="pg-table reveal">
          <thead><tr><th>Programme</th><th>One day</th></tr></thead>
          <tbody>
            <tr><td>Duration</td><td>2 hours</td></tr>
            <tr><td>Private, per person</td><td>USD 100</td></tr>
            <tr><td>Group of 10</td><td>USD 20</td></tr>
          </tbody>
        </table>
        <p class="pg-note">Programmes can be taken intensively or spread over several days, for individuals, couples, small groups or larger groups. The workshop is mostly customised to fit your schedule so there is leisure time to learn the art. More group programmes with longer duration are planned for the future.</p>
      </div>
    </div>

    <h3 class="h3 reveal" style="margin: clamp(3rem, 6vw, 5rem) 0 1.5rem" set:html={accent('From the ~studio~ and the *exhibitions*')}></h3>
    <div class="tg-grid">
      {thangkaGallery.map((g, i) => (
        <figure class="reveal" style={`--d:${(i % 3) * 80}ms`}>
          <Picture fallbackFormat="webp" src={g.img} alt={g.alt} widths={[400, 700, 1000]} sizes="(min-width:900px) 30vw, 92vw" formats={['avif', 'webp']} loading="lazy" />
          <figcaption class="label">{g.cap}</figcaption>
        </figure>
      ))}
    </div>
  </PageSection>

  <CtaBanner title="Pick your *experiences*. We’ll plan the ~rest~." cta="Start planning" href="/contact" />
</PageLayout>
<style>
  .tg-portrait { width: 100%; height: auto; display: block; border-radius: 0; }
  .tg-grid { columns: 3 260px; column-gap: 1rem; }
  .tg-grid figure { break-inside: avoid; margin: 0 0 1rem; }
  .tg-grid :global(img) { display: block; width: 100%; height: auto; border-radius: 0; }
  .tg-grid figcaption { margin-top: .5rem; opacity: .75; }
</style>
