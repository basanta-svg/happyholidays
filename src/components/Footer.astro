---
import { withBase } from '../lib/url';
import { site } from '../site.config';
import { icons } from '../lib/icons';
import Logo from './Logo.astro';
import { getImage } from 'astro:assets';
import bg from '../assets/images/footer.webp';
const bgImg = await getImage({ src: bg, width: 2400, format: 'webp', quality: 70 });
const year = new Date().getFullYear();
---
<footer class="ft" style={`--ft-bg:url(${bgImg.src})`}>
  <div class="horizon" aria-hidden="true"></div>
  <div class="big" aria-hidden="true"><span class="script">{site.name}</span></div>
  <div class="wrap grid">
    <div>
      <Logo stacked />
      <address class="label meta">{site.address}<br /><a href={`tel:${site.phone.replace(/ /g, "")}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></address>
    </div>
    {site.footerGroups.map((g) => (
      <nav aria-label={g.title}>
        <h2 class="gt">{g.title}</h2>
        <ul>{g.links.map((l) => <li><a class="label lk" href={withBase(l.href)}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
    <div>
      <h2 class="gt">Chat with us</h2>
      <ul class="soc">
        {site.socials.map((s) => (
          <li><a href={s.href} aria-label={s.label} target={s.href.startsWith("http") ? "_blank" : undefined} rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={icons[s.icon]} /></svg></a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap bottom label">
    <span>© {year} {site.name}. All rights reserved.</span>
    <span class="credit">Website designed and developed by <a href="https://abit.bt" target="_blank" rel="noopener">aBit Private Limited</a></span>
  </div>
</footer>
<style>
  .horizon { position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #0008FC 0 50%, #FECB00 50% 85%, #CC0000 85% 100%); }
  .ft { position: relative; isolation: isolate; background-color: #0A1233; color: #fff; padding-top: clamp(3rem, 6vw, 6rem); overflow: hidden; }
  .ft::before { content: ''; position: absolute; inset: 0; z-index: -2; background: var(--ft-bg) center / cover no-repeat; }
  .ft::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(10 18 51 / .55) 0%, rgb(10 18 51 / .8) 45%, rgb(10 18 51 / .92) 100%); }
  .big { text-align: center; color: #C9D1EA; white-space: nowrap; line-height: .8; padding-bottom: 1.5rem; }
  .big .script { font-size: clamp(3.5rem, 13.2vw, 15rem); display: inline-block; }
  .grid { display: grid; gap: 2.5rem; padding-block: 3rem; border-top: 1px solid rgb(255 255 255 / .3); }
  @media (min-width: 900px) { .grid { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; } }
  .meta { font-style: normal; margin-top: 1.25rem; text-transform: none; letter-spacing: .02em; font-size: 14px; opacity: .85; line-height: 1.7; }
  .gt { font-size: 1.25rem; font-weight: 400; margin-bottom: 1rem; }
  .ft ul { display: grid; gap: .6rem; }
  .lk { opacity: .85; transition: opacity .2s; }
  .lk:hover { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .soc { display: flex !important; flex-wrap: wrap; gap: .75rem !important; }
  .soc a { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid rgb(255 255 255 / .45); border-radius: 50%; transition: background .25s, color .25s; }
  .soc a:hover { background: #fff; color: #000; }
  .bottom { display: flex; flex-direction: column; align-items: center; text-align: center; gap: .5rem; padding-block: 1.5rem; border-top: 1px solid rgb(255 255 255 / .3); opacity: .9; }
  .credit { opacity: .8; }
  .credit a { text-decoration: underline; text-underline-offset: 3px; }
  .credit a:hover { color: var(--color-sage); }
</style>
