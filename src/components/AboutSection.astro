---
import { Picture } from 'astro:assets';
import { withBase } from '../lib/url';
import photo from '../assets/images/deck/image4.webp';
import photo2 from '../assets/images/cultural.webp';
---
<section id="about" class="ab" aria-labelledby="ab-title">
  <div class="wrap grid">
    <div class="pics">
      <div class="a reveal">
        <Picture fallbackFormat="webp" src={photo} alt="A warm Bhutanese welcome" widths={[480, 800, 1000]} sizes="(min-width:900px) 34vw, 90vw" formats={['avif', 'webp']} class="img" />
        <p class="cap h3">Tailor-made<br />journeys</p>
      </div>
      <Picture fallbackFormat="webp" src={photo2} alt="Bhutanese cultural dance" widths={[400, 700]} sizes="(min-width:900px) 24vw, 60vw" formats={['avif', 'webp']} class="img b reveal" style="--d:150ms" />
    </div>
    <div class="txt">
      <p class="label reveal">About us</p>
      <h2 id="ab-title" class="h2 reveal" style="--d:80ms"><span class="ac-r">Happiness</span> is a way of <span class="ac-b">life</span> here.</h2>
      <p class="p reveal" style="--d:160ms">Happy Holidays is a Bhutan travel agency. We plan cultural, festival, pilgrimage and adventure journeys built around lesser-known routes, and we welcome every guest with local people who know the stories behind each temple, trail and village.</p>
      <p class="p reveal" style="--d:220ms">From the first greeting at Paro airport to the farewell at departure, we look after the details so you can simply be there.</p>
      <a class="btn btn-label reveal" style="--d:280ms" href={withBase('/about')}>More about us</a>
    </div>
  </div>
</section>
<style>
  .ab { position: relative; z-index: 2; overflow: hidden; background: var(--color-paper-2); color: var(--color-ink); padding-block: var(--section-pad); }
  .grid { position: relative; display: grid; gap: 3.5rem; align-items: center; }
  .txt { display: grid; gap: 1.25rem; justify-items: start; }
  .txt .label { color: var(--color-ink); }
  .txt :global(.h2) { max-width: 14ch; }
  .p { color: var(--color-muted); max-width: 52ch; }
  .btn { display: inline-block; margin-top: .75rem; padding: .45rem .85rem; font-size: .72rem; background: var(--color-sage); color: var(--color-ink); border-radius: 0; transition: transform .35s var(--ease), background .3s; }
  .btn:hover { transform: translateY(-2px); background: #ffd92e; }
  .pics { position: relative; padding-bottom: 3rem; }
  .pics :global(.img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .a { position: relative; width: 78%; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 0; }
  .a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(19 33 85 / .55), rgb(19 33 85 / 0) 45%); pointer-events: none; }
  .cap { position: absolute; z-index: 1; top: 1.5rem; left: 1.5rem; color: #fff; }
  .pics :global(.b) { position: absolute; right: 0; bottom: 0; width: 52%; height: auto; aspect-ratio: 3 / 4; border-radius: 0; box-shadow: 0 30px 60px rgb(19 33 85 / .25); }
  @media (min-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .a { aspect-ratio: auto; height: min(76vh, 820px); }
    .pics :global(.b) { aspect-ratio: auto; height: min(42vh, 460px); }
    }
</style>
