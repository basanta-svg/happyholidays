---
interface Props { items: string[]; interval?: number }
const { items, interval = 4000 } = Astro.props;
---
<h1 class="rot h1" data-rotating data-interval={interval}>
  {items.map((q, i) => <span class="q" data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'}>{q}</span>)}
</h1>
<style>
  .rot { display: grid; max-width: 24ch; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.15; }
  .q { grid-area: 1 / 1; opacity: 0; transform: translateY(24px); transition: opacity .8s var(--ease), transform .8s var(--ease); pointer-events: none; }
  .q[data-active='true'] { opacity: 1; transform: none; pointer-events: auto; }
  .q[data-leaving='true'] { transform: translateY(-24px); }
  @media (prefers-reduced-motion: reduce) { .q { transition: none; } }
</style>
