---
import { Picture } from 'astro:assets';
import { withBase } from '../lib/url';
import { accent } from '../lib/accent';
import artist from '../assets/images/thangka/artist-phuntsho.webp';
import wall from '../assets/images/thangka/thangka-wall.webp';
const facts = [
  { n: '2 hrs', l: 'Workshop length', c: 'r' },
  { n: 'USD 100', l: 'Private, per person', c: 'b' },
  { n: 'USD 20', l: 'Group of 10', c: 'r' },
];
---
<section id="thangka-workshop" class="th" aria-labelledby="th-title">
  <div class="wrap grid">
    <div class="pics">
      <div class="a reveal">
        <Picture fallbackFormat="webp" src={artist} alt="Artist Phuntsho Wangdi painting a mask" widths={[480, 800, 1000]} sizes="(min-width:900px) 34vw, 90vw" formats={['avif', 'webp']} loading="lazy" class="img" />
      </div>
      <div class="b reveal" style="--d:150ms">
        <Picture fallbackFormat="webp" src={wall} alt="A wall of thangka paintings" widths={[400, 700]} sizes="(min-width:900px) 22vw, 50vw" formats={['avif', 'webp']} loading="lazy" class="img" />
      </div>
      <p class="tag label reveal" style="--d:250ms">Paro · limited seats</p>
    </div>
    <div class="txt">
      <p class="label reveal">Activity · Traditional arts</p>
      <h2 id="th-title" class="h2 reveal" style="--d:80ms" set:html={accent('Paint a *thangka*.<br>Learn the _sacred art_ of Bhutan.')}></h2>
      <p class="p reveal" style="--d:160ms">Spend a morning with a Paro-based artist who runs a thangka painting studio and teaches visitors who want to know more about Bhutan’s arts. Seats are limited, so every guest gets proper attention, and the session fits around your day.</p>
      <ul class="facts">
        {facts.map((f, i) => (
          <li class="reveal" style={`--d:${i * 90}ms`}><strong class={`c-${f.c}`}>{f.n}</strong><span class="label">{f.l}</span></li>
        ))}
      </ul>
      <div class="acts reveal" style="--d:300ms">
        <a class="btn btn-label" href={withBase('/activities')}>More activities</a>
      </div>
    </div>
  </div>
</section>
<style>
  .th { position: relative; z-index: 2; background: var(--color-paper-2); color: var(--color-ink); min-height: 100vh; min-height: 100svh; display: flex; align-items: center; padding-block: clamp(5.5rem, 12vh, 7rem) clamp(2rem, 6vh, 4rem); }
  .th > .grid { width: 100%; }
  .grid { display: grid; gap: 3.5rem; align-items: center; }
  .pics { position: relative; padding-bottom: 3rem; }
  .a { width: 76%; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 0; }
  .b { position: absolute; right: 0; bottom: 0; width: 46%; aspect-ratio: 1; overflow: hidden; border-radius: 0; border: 6px solid var(--color-paper-2); box-shadow: 0 24px 50px rgb(19 33 85 / .22); }
  .pics :global(.img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tag { position: absolute; left: 0; bottom: 0; padding: .55rem 1rem; background: var(--color-ink); color: #fff; border-radius: var(--radius-card); }
  .txt { display: grid; gap: 1.25rem; justify-items: start; }
  .txt > .label { color: var(--color-ink); }
  .txt :global(.h2) { max-width: 18ch; }
  .p { color: var(--color-muted); max-width: 52ch; }
  .facts { list-style: none; margin: .5rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid rgb(19 33 85 / .2); display: grid; grid-template-columns: repeat(3, auto); gap: 1.5rem 2.5rem; justify-content: start; }
  .facts li { display: grid; gap: .25rem; }
  .facts strong { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1; }
  .c-r { color: var(--color-brand); }
  .c-b { color: var(--color-ink); }
  .facts .label { opacity: .7; }
  .acts { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: .5rem; }
  .btn { display: inline-block; padding: .45rem .85rem; font-size: .72rem; background: var(--color-sage); color: var(--color-ink); border-radius: 0; transition: transform .35s var(--ease), background .3s; }
  .btn:hover { transform: translateY(-2px); background: #ffd92e; }
  @media (min-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .a { width: auto; height: min(62vh, 62svh, 560px); }
  }
  @media (max-width: 480px) { .facts { grid-template-columns: repeat(2, auto); } }
</style>
