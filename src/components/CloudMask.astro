---
// Diamond clip-path in objectBoundingBox units. Wrap an <img> in an element with style="clip-path:url(#id)".
interface Props { id?: string }
const { id = 'cloud-mask' } = Astro.props;
---
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <defs>
    <clipPath id={id} clipPathUnits="objectBoundingBox"><polygon points="0.5,0.02 0.98,0.5 0.5,0.98 0.02,0.5" /></clipPath>
  </defs>
</svg>
