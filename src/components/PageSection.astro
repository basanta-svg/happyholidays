---
interface Props { tone?: 'ink' | 'plum' | 'dusty' | 'paper' | 'sand'; id?: string; class?: string; labelledby?: string }
const { tone = 'ink', id, class: cls = '', labelledby } = Astro.props;
---
<section id={id} aria-labelledby={labelledby} class:list={['ps', tone, cls]}>
  <div class="wrap"><slot /></div>
</section>
<style>
  .ps { padding-block: var(--section-pad); scroll-margin-top: 4.5rem; position: relative; z-index: 1; }
  .ink { background: #186093; color: var(--color-paper); }
  .plum { background: #186093; color: var(--color-paper); }
  .dusty { background: #186093; color: var(--color-paper); }
  .paper { background: #186093; color: var(--color-paper); }
  .sand { background: #186093; color: var(--color-paper); }
</style>
