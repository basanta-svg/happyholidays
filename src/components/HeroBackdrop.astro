---
// One shared background (photo + looping video) that stays pinned behind the hero and the statement section.
import { withBase } from '../lib/url';
import { site } from '../site.config';
---
<div class="backdrop" aria-hidden="true">
  <img class="bg" src={withBase('/images/hero-poster.webp')} alt="" width="1920" height="1440" loading="eager" fetchpriority="high" decoding="async" />
  <div class="yt" data-yt={site.heroYoutubeId}><div id="hero-yt"></div></div>
  <video class="vid" data-src={withBase(site.heroVideo)} muted loop playsinline preload="none" poster={withBase('/images/hero-poster.webp')} tabindex="-1" disablepictureinpicture disableremoteplayback></video>
  <div class="shade"></div>
</div>
<style>
  .backdrop { position: sticky; top: 0; height: 100svh; margin-bottom: -100svh; overflow: hidden; z-index: 0; pointer-events: none; }
  .backdrop .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.2s ease; }
  .yt { position: absolute; inset: 0; overflow: hidden; opacity: 0; transition: opacity 1.2s ease; }
  .yt.on { opacity: 1; }
  .yt :global(iframe) { position: absolute; top: 50%; left: 50%; width: max(100vw, 177.78svh); height: max(100svh, 56.25vw); transform: translate(-50%, -50%); border: 0; pointer-events: none; }
  .vid:global(.on) { opacity: 1; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 9 6 / .3) 0%, rgb(10 9 6 / .12) 45%, rgb(10 9 6 / .45) 100%); }
</style>
