---
import { site } from '../site.config';
import { accent } from '../lib/accent';
---
<section id="why-bhutan" class="www" aria-labelledby="why-title">
  <div class="wrap">
    <h2 id="why-title" class="h2 reveal ttl" set:html={accent('Why *choose* _us_')}></h2>
    <div class="cols">
      {site.why.map((c, i) => (
        <article class="col reveal" style={`--d:${i * 120}ms`}>
          <span class="n" aria-hidden="true">0{i + 1}</span>
          <h3 class="h3">{c.title}</h3>
          <p>{c.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .www { position: relative; z-index: 2; background: var(--color-paper-2); color: var(--color-ink); padding-block: var(--section-pad); }
  .ttl { margin-bottom: 3.5rem; max-width: 14ch; text-transform: uppercase; }
  .cols { display: grid; gap: 1.25rem; }
  .col { background: #fff; border-radius: 20px; padding: 2rem; display: grid; gap: 1rem; align-content: start; box-shadow: 0 1px 0 rgb(19 33 85 / .08); }
  .n { font-family: var(--font-display); font-weight: 400; font-size: 3.5rem; line-height: 1; color: var(--color-brand); }
  .col p { color: var(--color-muted); max-width: 34ch; }
  @media (min-width: 900px) {
    .cols { grid-template-columns: repeat(3, 1fr); }
    .col { min-height: 20rem; padding: 2.5rem; }
    .col:nth-child(2) { background: var(--color-ink); color: #fff; }
    .col:nth-child(2) p { color: rgb(255 255 255 / .8); }
    .col:nth-child(2) .n { color: var(--color-sage); }
  }
</style>
