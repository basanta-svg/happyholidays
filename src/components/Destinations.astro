---
import { getCollection } from 'astro:content';
import { site } from '../site.config';
import ArrowLink from './ArrowLink.astro';
import Marquee from './Marquee.astro';
const items = (await getCollection('hotels')).sort((a, b) => a.data.order - b.data.order).map((s) => s.data);
---
<section id="hotels" class="sp" aria-labelledby="ht-title">
  <div class="wrap head">
    <h2 id="ht-title" class="h3 reveal">{site.hotelsIntro}</h2>
    <div class="reveal" style="--d:120ms"><ArrowLink href={site.hotelsUrl}>All hotels</ArrowLink></div>
  </div>
  <Marquee items={items} label="Hotel partners" />
</section>
<style>
  .sp { background: var(--color-ink-deep); padding-block: var(--section-pad); min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 4rem; }
  .head { display: grid; gap: 1.5rem; justify-items: start; }
  .head :global(.h3) { max-width: 28ch; }
</style>
