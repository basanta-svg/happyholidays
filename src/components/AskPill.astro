---
import { site } from '../site.config';
---
<button id="ask-btn" class="ask label" aria-haspopup="dialog" aria-controls="ask-dialog">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z" /></svg>
  Ask {site.short}
</button>
<dialog id="ask-dialog" class="drawer" aria-labelledby="ask-title">
  <div class="head">
    <h2 id="ask-title" class="h3">Ask {site.short}</h2>
    <button class="close label" data-close aria-label="Close">Close ✕</button>
  </div>
  <ul class="faq">
    {site.askFaq.map((f) => <li><strong>{f.q}</strong><p>{f.a}</p></li>)}
  </ul>
  <form class="ask-form" onsubmit="return false">
    <label for="ask-input" class="label">Your question</label>
    <input id="ask-input" type="text" placeholder="Type here (placeholder chat)" />
    <button class="label send" type="submit">Send →</button>
  </form>
</dialog>
<style>
  .ask { position: fixed; z-index: 45; bottom: 1.25rem; left: 50%; translate: -50% 0; display: inline-flex; align-items: center; gap: .6rem; padding: .85rem 1.3rem; color: #fff; border-radius: 9999px; background: rgb(30 28 22 / .45); backdrop-filter: blur(16px) saturate(1.4); border: 1px solid rgb(255 255 255 / .25); cursor: pointer; transition: transform .3s var(--ease); }
  .ask:hover { transform: translateY(-3px); }
  .drawer { margin: 0 0 0 auto; height: 100dvh; max-height: 100dvh; width: min(100%, 26rem); background: var(--color-paper-2); color: var(--color-ink); padding: 1.5rem; border: 0; }
  .drawer::backdrop { background: rgb(0 0 0 / .5); }
  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .faq { display: grid; gap: 1rem; }
  .faq li { border-top: 1px solid rgb(0 0 0 / .15); padding-top: 1rem; }
  .faq p { color: #55503f; font-size: 16px; }
  .ask-form { display: grid; gap: .6rem; margin-top: 2rem; }
  .ask-form input { border: 1px solid rgb(0 0 0 / .25); border-radius: 12px; padding: .8rem 1rem; background: #fff; font: inherit; }
  .send { justify-self: start; background: #000; color: #fff; padding: .8rem 1.3rem; border-radius: 9999px; }
</style>
