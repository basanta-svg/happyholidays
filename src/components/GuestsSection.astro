---
import { withBase } from '../lib/url';
import { accent } from '../lib/accent';
import GuestsSlider from './GuestsSlider.astro';
---
<section id="guests" class="gs" aria-labelledby="gs-title">
  <div class="wrap">
    <header class="head">
      <p class="label reveal">Our guests</p>
      <h2 id="gs-title" class="h2 reveal" style="--d:80ms" set:html={accent('Moments with our *guests* across ~Bhutan~.')}></h2>
      <p class="p reveal" style="--d:140ms">From the first welcome scarf to shared lunches in dzong courtyards, here are some of the travellers we have had the pleasure of hosting. Tap a photo to see it full screen.</p>
      <a class="btn btn-label reveal" style="--d:200ms" href={withBase('/contact')}>Plan your trip</a>
    </header>
  </div>
  <GuestsSlider bleed keys={['banner', 'dress1', 'lunch2', 'courtyardGroup', 'bridge', 'onSteps', 'scarves', 'outdoorLunch', 'dress2', 'groupPhoto']} />
</section>
<style>
  .gs { position: relative; z-index: 2; padding-block: var(--section-pad); overflow-x: clip; }
  .head { display: grid; gap: 1.25rem; justify-items: start; max-width: 46rem; margin-bottom: 2.5rem; }
  .head > .label { color: #C9D1EA; }
  .p { color: #C9D1EA; max-width: 52ch; }
  .btn { display: inline-block; margin-top: .5rem; padding: .45rem .85rem; font-size: .72rem; background: var(--color-sage); color: var(--color-ink); border-radius: 0; transition: transform .35s var(--ease), background .3s; }
  .btn:hover { transform: translateY(-2px); background: #ffd92e; }
</style>
