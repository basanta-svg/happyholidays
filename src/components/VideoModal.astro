---
import { site } from '../site.config';
const src = site.videoProvider === 'vimeo'
  ? `https://player.vimeo.com/video/${site.videoId}?autoplay=1`
  : `https://www.youtube-nocookie.com/embed/${site.videoId}?autoplay=1&rel=0`;
---
<dialog id="video-dialog" class="vm" aria-label="Welcome film" data-src={src}>
  <button class="label x" data-close aria-label="Close video">Close ✕</button>
  <div class="frame" data-frame></div>
</dialog>
<style>
  .vm { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; background: #000; border: 0; }
  .vm::backdrop { background: #000; }
  .vm[open] { display: grid; place-items: center; }
  .frame { width: min(100vw, 177vh); aspect-ratio: 16/9; }
  .frame :global(iframe) { width: 100%; height: 100%; border: 0; }
  .x { position: absolute; top: 1.25rem; right: 1.25rem; z-index: 2; color: #fff; padding: .8rem 1.2rem; border-radius: 9999px; border: 1px solid rgb(255 255 255 / .4); background: rgb(0 0 0 / .5); }
</style>
