---
interface Props { href?: string; variant?: 'light' | 'dark' | 'glass'; class?: string; type?: 'button' | 'submit'; [k: string]: unknown }
import { withBase } from '../lib/url';
const { href: rawHref, variant = 'light', class: cls = '', type = 'button', ...rest } = Astro.props;
const href = rawHref ? withBase(rawHref) : undefined;
const Tag = href ? 'a' : 'button';
---
<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['pill label', variant, cls]}
  {...rest}
>
  <slot />
  <span aria-hidden="true" class="pill-arrow">→</span>
</Tag>
<style>
  .pill { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.95rem 1.6rem; border-radius: 9999px; font-weight: 500; transition: transform .35s var(--ease), background .3s, color .3s; cursor: pointer; white-space: nowrap; }
  .pill:hover { transform: translateY(-2px); }
  .pill:hover .pill-arrow { transform: translateX(4px); }
  .pill-arrow { transition: transform .3s var(--ease); }
  .light { background: #fff; color: var(--color-ink); }
  .dark { background: #000; color: #fff; }
  .glass { background: rgb(255 255 255 / .14); color: #fff; backdrop-filter: blur(14px); border: 1px solid rgb(255 255 255 / .25); }
</style>
