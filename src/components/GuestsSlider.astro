---
import { Picture, getImage } from 'astro:assets';
import { guests, type GuestKey } from '../data/guests';
interface Props { keys: GuestKey[]; bleed?: boolean }
const { keys, bleed = false } = Astro.props;
// Large version shown in the viewer when a photo is clicked
const items = await Promise.all(keys.map(async (k) => ({
  ...guests[k],
  full: (await getImage({ src: guests[k].img, width: 1800, format: 'webp', quality: 80 })).src,
})));
---
  <div class:list={['slider', { bleed }]} data-guest-slider>
    <ul class="track" tabindex="0" aria-label="Photos of our guests">
      {items.map((g, i) => (
        <li class="card">
          <button type="button" class="zoom" data-i={i} data-full={g.full} data-alt={g.alt} aria-label={`View larger: ${g.alt}`}>
            <Picture fallbackFormat="webp" src={g.img} alt={g.alt} widths={[320, 560, 800]} sizes="(min-width:900px) 18rem, 70vw" formats={['avif', 'webp']} loading="lazy" draggable="false" />
          </button>
        </li>
      ))}
    </ul>
  </div>

<dialog id="guest-lb" class="lb" aria-label="Guest photo viewer">
  <button type="button" class="lb-close" data-lb-close aria-label="Close photo">×</button>
  <button type="button" class="lb-nav lb-prev" data-lb-dir="-1" aria-label="Previous photo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
  <img alt="" />
  <button type="button" class="lb-nav lb-next" data-lb-dir="1" aria-label="Next photo"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
  <p class="lb-count label" aria-live="polite"><span data-cur>1</span> / {items.length}</p>
</dialog>

<style>
  .slider { min-width: 0; }
  .track { display: flex; gap: 1rem; margin: 0; padding: 0; list-style: none; overflow-x: auto; scrollbar-width: none; cursor: grab; -webkit-overflow-scrolling: touch; }
  .bleed .track { padding-inline: var(--gutter); }
  .track::-webkit-scrollbar { display: none; }
  .track.drag { cursor: grabbing; user-select: none; }
  .track:focus-visible { outline-offset: 6px; }
  .card { flex: none; width: min(70vw, 18rem); aspect-ratio: 3 / 4; overflow: hidden; border-radius: 0; background: var(--color-ink); }
  .zoom { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; color: inherit; }
  .zoom :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0; transition: transform .8s var(--ease); pointer-events: none; }
  .card:hover :global(img) { transform: scale(1.05); }

  /* Full-screen viewer */
  .lb { position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(6 10 28 / .96); color: #fff; opacity: 0; transition: opacity .35s var(--ease); }
  .lb[open] { display: grid; place-items: center; }
  .lb.shown { opacity: 1; }
  .lb::backdrop { background: rgb(0 0 0 / .8); }
  .lb img { max-width: min(92vw, 1400px); max-height: 88vh; max-height: 88dvh; width: auto; height: auto; object-fit: contain; border-radius: 0; transition: opacity .25s ease; }
  .lb img.swap { opacity: 0; }
  .lb-close { position: absolute; top: 1rem; right: 1.25rem; width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .5); border-radius: 0; background: rgb(255 255 255 / .08); color: #fff; font-size: 30px; line-height: 1; cursor: pointer; transition: background .25s; }
  .lb-close:hover { background: #E01B24; border-color: #E01B24; }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 52px; height: 52px; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .5); border-radius: 0; background: rgb(255 255 255 / .08); color: #fff; cursor: pointer; transition: background .25s; }
  .lb-nav:hover { background: var(--color-sage); color: var(--color-ink); border-color: var(--color-sage); }
  .lb-prev { left: 1rem; } .lb-next { right: 1rem; }
  .lb-count { position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%); opacity: .8; }
  @media (prefers-reduced-motion: reduce) { .lb, .lb img { transition: none; } }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-guest-slider]');
  const lb = document.querySelector<HTMLDialogElement>('#guest-lb');
  if (root && lb) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const zooms = [...root.querySelectorAll<HTMLButtonElement>('.zoom')];
    const img = lb.querySelector<HTMLImageElement>('img')!;
    const cur = lb.querySelector<HTMLElement>('[data-cur]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;

    // ---- viewer: click a photo, close it, or slide to the next
    const show = (i: number) => {
      index = (i + zooms.length) % zooms.length;
      const z = zooms[index];
      img.classList.add('swap');
      setTimeout(() => { img.src = z.dataset.full!; img.alt = z.dataset.alt ?? ''; cur.textContent = String(index + 1); }, reduce ? 0 : 120);
      img.onload = () => img.classList.remove('swap');
    };
    const open = (i: number) => {
      lb.showModal(); document.body.style.overflow = 'hidden';
      index = i; const z = zooms[i]; img.src = z.dataset.full!; img.alt = z.dataset.alt ?? ''; cur.textContent = String(i + 1);
      requestAnimationFrame(() => requestAnimationFrame(() => lb.classList.add('shown')));
    };
    const close = () => {
      if (!lb.open) return;
      lb.classList.remove('shown');
      setTimeout(() => lb.close(), reduce ? 0 : 350);
    };
    lb.addEventListener('close', () => { document.body.style.overflow = ''; });
    lb.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    lb.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === lb || t.closest('[data-lb-close]')) close();
      const nav = t.closest<HTMLElement>('[data-lb-dir]'); if (nav) show(index + Number(nav.dataset.lbDir));
    });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    // ---- slider: smooth auto drift, paused while the pointer is over it or a photo is open
    let down = false, moved = false, startX = 0, startLeft = 0, hover = false, visible = true, resting = 0, pos = track.scrollLeft, last = 0;
    new IntersectionObserver((en) => { visible = en[0].isIntersecting; }).observe(root);
    track.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    track.addEventListener('pointerleave', () => { hover = false; });
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5) { moved = true; track.classList.add('drag'); }
      if (moved) track.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => { if (down) { down = false; track.classList.remove('drag'); } });
    track.addEventListener('click', (e) => {
      if (moved) { e.preventDefault(); moved = false; return; }
      const z = (e.target as HTMLElement).closest<HTMLButtonElement>('.zoom');
      if (z) open(Number(z.dataset.i));
    });
    track.addEventListener('wheel', () => { resting = 1.5; }, { passive: true });
    track.addEventListener('touchstart', () => { resting = 3; }, { passive: true });

    if (!reduce) {
      const SPEED = 45; // px per second
      const tick = (t: number) => {
        const dt = Math.min(64, t - last) / 1000; last = t;
        const paused = !visible || hover || down || document.hidden || lb.open || track.matches(':focus-within');
        if (paused) pos = track.scrollLeft;
        else if (resting > 0) { resting -= dt; pos = track.scrollLeft; }
        else {
          const max = track.scrollWidth - track.clientWidth;
          if (pos >= max - 1) { resting = 1.2; track.style.scrollBehavior = 'smooth'; track.scrollLeft = 0; setTimeout(() => { track.style.scrollBehavior = ''; pos = 0; }, 900); }
          else { pos = Math.min(max, pos + SPEED * dt); track.scrollLeft = pos; }
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
